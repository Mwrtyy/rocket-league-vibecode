{
  "name": "aether-strike",
  "version": "0.1.0",
  "private": true,
  "description": "Clean-room browser-based competitive rocket car football simulation.",
  "license": "MIT",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @aether/client --filter @aether/server --filter @aether/physics-lab dev",
    "dev:client": "pnpm --filter @aether/client dev",
    "dev:server": "pnpm --filter @aether/server dev",
    "dev:physics": "pnpm --filter @aether/physics-lab dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:physics": "vitest run packages/simulation/src/**/*.test.ts packages/physics-adapter/src/**/*.test.ts",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "eslint": "10.7.0",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "tsx": "4.22.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
